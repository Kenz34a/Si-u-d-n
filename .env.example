PORT=3000
HOST=0.0.0.0
ANIME_DATABASE_PATH=.data/nexus.sqlite
ANIME_ADMIN_USERNAME=admin
# Leave blank to generate a password in .data/admin-bootstrap.txt at first startup.
ANIME_ADMIN_PASSWORD=
# Set to the public HTTPS origin and true for a server deployed behind HTTPS.
ANIME_APP_ORIGIN=
ANIME_SECURE_COOKIE=false
